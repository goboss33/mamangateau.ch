# ---------------------------------------------------------------------------
# mamangateau.ch — variables d'environnement
# Copier en .env.local pour le développement (ignoré par git).
# En production : variables du conteneur (Portainer).
# ---------------------------------------------------------------------------

# --- Carnet (back-office) ---------------------------------------------------
# Tarifs lus par le configurateur. Sans cette variable, le site utilise ses
# valeurs locales (lib/data.ts) : aucune panne, mais aucune synchronisation.
CARNET_URL=https://carnet.mamangateau.ch
# Webhook des demandes de devis (doit correspondre au HOOK_SECRET de Carnet)
CARNET_HOOK_URL=https://carnet.mamangateau.ch/api/hooks/devis
CARNET_HOOK_SECRET=

# --- Google -----------------------------------------------------------------
# Clé SERVEUR : autocomplétion d'adresse du configurateur (Places Autocomplete).
# Si la clé est restreinte par IP, pense à y mettre AUSSI l'IPv6 du serveur :
# Node sort en IPv6 dès qu'elle existe, et Google refuse alors la requête.
GOOGLE_MAPS_SERVER_KEY=
# Note et avis Google : plus de variable ici, ils se saisissent dans
# Carnet → Réglages et arrivent par l'API des tarifs. La fiche est un
# établissement « zone de service » (sans adresse publique), absent de l'index
# de l'API Places : aucune requête ne peut la lire.

# --- E-mail (Brevo) ---------------------------------------------------------
BREVO_API_KEY=
DEVIS_TO=
DEVIS_FROM_EMAIL=
DEVIS_FROM_NAME=Maman Gâteau

# --- Divers -----------------------------------------------------------------
# Durée du cookie de parrainage partenaire (jours)
NEXT_PUBLIC_REF_COOKIE_DAYS=30
