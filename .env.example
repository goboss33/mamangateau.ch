# ---------------------------------------------------------------------------
# mamangateau.ch — variables d'environnement
# Copier en .env.local pour le développement (ignoré par git).
# En production : variables du conteneur (Portainer).
# ---------------------------------------------------------------------------

# --- Carnet (back-office) ---------------------------------------------------
# Tarifs lus par le configurateur. Sans cette variable, le site utilise ses
# valeurs locales (lib/data.ts) : aucune panne, mais aucune synchronisation.
CARNET_URL=https://carnet.mamangateau.ch
# Webhook des demandes de devis (doit correspondre au HOOK_SECRET de Carnet)
CARNET_HOOK_URL=https://carnet.mamangateau.ch/api/hooks/devis
CARNET_HOOK_SECRET=

# --- Google -----------------------------------------------------------------
# Clé SERVEUR : autocomplétion d'adresse + calcul de distance (Routes API).
# Attention : si la clé est restreinte par IP, elle ne marche qu'en production.
GOOGLE_MAPS_SERVER_KEY=
# Facultatif : clé dédiée à Places si différente de la précédente
PLACES_API_KEY=
# Fiche Google Business (note et avis affichés sur le site)
GOOGLE_PLACE_ID=

# --- E-mail (Brevo) ---------------------------------------------------------
BREVO_API_KEY=
DEVIS_TO=
DEVIS_FROM_EMAIL=
DEVIS_FROM_NAME=Maman Gâteau

# --- Divers -----------------------------------------------------------------
# Durée du cookie de parrainage partenaire (jours)
NEXT_PUBLIC_REF_COOKIE_DAYS=30
